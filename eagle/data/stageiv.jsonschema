{
  "$defs": {
    "datetime": {
      "anyOf": [
        {
          "type": "datetime"
        },
        {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}(:[0-9]{2})?(:[0-9]{2})?$",
          "type": "string"
        }
      ]
    },
    "timedelta": {
      "anyOf": [
        {
          "type": "timedelta"
        },
        {
          "type": "integer"
        },
        {
          "pattern": "^[0-9]+(:[0-9]+(:[0-9]+)?)?$",
          "type": "string"
        }
      ]
    },
    "timerange": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "$ref": "#/$defs/timedelta"
        },
        "step": {
          "$ref": "#/$defs/timedelta"
        },
        "stop": {
          "$ref": "#/$defs/timedelta"
        }
      },
      "required": [
        "start",
        "step",
        "stop"
      ],
      "type": "object"
    }
  },
  "properties": {
    "stageiv": {
      "additionalProperties": false,
      "properties": {
        "archive_url": {
          "pattern": "^https://.*\\{yyyymm\\}.*$",
          "type": "string"
        },
        "cycles": {
          "additionalProperties": false,
          "properties": {
            "start": {
              "$ref": "#/$defs/datetime"
            },
            "step": {
              "$ref": "#/$defs/timedelta"
            },
            "stop": {
              "$ref": "#/$defs/datetime"
            }
          },
          "required": [
            "start",
            "step",
            "stop"
          ],
          "type": "object"
        },
        "execution": {
          "$ref": "urn:uwtools:execution-serial"
        },
        "leadtimes": {
          "$ref": "#/$defs/timerange"
        },
        "output_path": {
          "type": "string"
        },
        "rundir": {
          "type": "string"
        }
      },
      "required": [
        "archive_url",
        "cycles",
        "execution",
        "leadtimes",
        "output_path",
        "rundir"
      ],
      "type": "object"
    }
  },
  "required": [
    "stageiv"
  ],
  "type": "object"
}
